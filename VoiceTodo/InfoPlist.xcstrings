    "CFBundleName" : {
      "comment" : "Bundle name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceTodo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
